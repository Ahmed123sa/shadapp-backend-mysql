APP_NAME=ShadApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The codebase is database-agnostic: all vendor-specific SQL goes through
# App\Support\DbExpr, and every migration uses the schema builder.
# Supported: pgsql (default dev), mysql/mariadb, sqlite (test suite only).
#
# PostgreSQL:
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shadapp
DB_USERNAME=shadapp
DB_PASSWORD=

# MySQL — swap the block above for this one:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=shadapp
# DB_USERNAME=shadapp
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Redis — backs cache, sessions and queues
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# predis is pure PHP and needs no extension; phpredis is a C extension and is
# noticeably faster under load. Prefer phpredis in production.
REDIS_CLIENT=predis

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# 'local' writes to the app server's own disk, which prevents running more than
# one app server. Use 's3' for any multi-server deployment.
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Set when using MinIO or another S3-compatible service; leave blank for real AWS.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------------------
# Broadcasting (realtime chat/notifications)
# ---------------------------------------------------------------------------
# Must be "reverb": with "null" notifications still reach the list and FCM,
# but nothing updates live (chat, onboarding toasts, badges).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# The host/port the BACKEND sends broadcast events to Reverb on. If Reverb is on the
# same server, keep 127.0.0.1 and port 8080.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@shadapp.com
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Third-party integrations
# ---------------------------------------------------------------------------
FCM_SERVER_KEY=
FCM_SENDER_ID=

# In-app account deletion (App Store 5.1.1(v)) — DELETE /api/auth/account.
# Set to false to switch it off; already-deleted accounts stay deleted.
ACCOUNT_DELETION_ENABLED=true

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# Directory holding pg_dump / mysqldump, used by `php artisan db:backup`.
# Leave empty on a Linux server, where they are already on the PATH. Set it if
# the client tools are installed elsewhere — WAMP and XAMPP ship them without
# touching the PATH, e.g. C:/wamp64/bin/mysql/mysql8.0.31/bin
#
# Use forward slashes and no quotes on Windows: a double-quoted .env value is
# parsed for escape sequences, so "C:\wamp64\bin" is rejected on \w and \b.
DB_DUMP_BINARY_PATH=

# Base URL of the Next.js dashboard — used to build the password reset link
# that lands in the user's browser. Must be reachable by the recipient, so in
# production this is your real dashboard domain, not localhost.
FRONTEND_URL=http://localhost:3000

DEBUGBAR_ENABLED=false

# ── Logging ───────────────────────────────────────────────────────────────
# 'daily' rotates into laravel-YYYY-MM-DD.log and prunes files older than
# LOG_DAILY_DAYS. Laravel's default ('single') appends to one laravel.log
# forever — it grows unbounded in production and becomes unusable.
# LOG_LEVEL: keep 'debug' locally, use 'warning' or 'error' in production.
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# API token lifetime in minutes (default 60 days = 86400).
# SANCTUM_EXPIRATION=86400
